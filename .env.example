# Set these in Netlify > Site configuration > Environment variables.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-SITE.netlify.app/.netlify/functions/auth-callback
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DASHBOARD_SYNC_TOKEN=use-a-different-long-random-secret-for-the-termux-bridge
